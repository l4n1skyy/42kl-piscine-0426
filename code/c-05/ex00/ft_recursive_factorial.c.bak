#include <stdio.h>

int	ft_iterative_factorial(int nb);
int	calculate_factorial(int n);
int	validate_input(int n);

int	ft_iterative_factorial(int nb)
{
	if (!validate_input(nb))
		return (0);
	int n = calculate_factorial(nb);
	return (n);
}

int	calculate_factorial(int n)
{
	if (n == 1)
		return (1);
	return (n * calculate_factorial(n - 1));
}

int	validate_input(int n)
{
	if (n < 0)
		return (0);
	return (1);
}
