# Shared configuration for prep scripts.
# File path is absolute at runtime because each script resolves:
#   config_file="<absolute_script_dir>/prep.config"
#
# Required paths:
# SCRIPTS_DIR=/absolute/path/to/scripts
# CODE_DIR=/absolute/path/to/code-or-project-root
#
# Optional identity used by prep-header:
# PREP_USERNAME=lanusri-
# PREP_EMAIL=lanusri-@student.42kl.edu.my
