#!/usr/bin/env bash

set -euo pipefail

die() {
    echo "Error: $*" >&2
    exit 1
}

warn() {
    echo "Warning: $*" >&2
}

usage() {
    echo "Usage: $0 [scripts=<path> code=<path>] <folder>" >&2
    echo "Examples:" >&2
    echo "  $0 scripts=./scripts code=./code" >&2
    echo "  $0 c-01" >&2
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "required command '$1' not found."
}

script_dir="$(cd "$(dirname "$0")" && pwd)"
config_file="$script_dir/.prep-code.conf"

tmp_files=()

cleanup() {
    local f

    for f in "${tmp_files[@]:-}"; do
        if [[ -n "$f" && -e "$f" ]]; then
            rm -f "$f"
        fi
    done
}

trap cleanup EXIT

for cmd in awk cat chmod cmp dirname find mktemp mv pwd sort; do
    require_cmd "$cmd"
done

MAX_NORM_PASSES=3

abs_dir() {
    local p="$1"

    [[ -d "$p" ]] || return 1
    (cd "$p" && pwd)
}

resolve_dir_arg() {
    local raw="$1"

    if [[ "$raw" == /* ]]; then
        abs_dir "$raw" || return 1
        return
    fi

    if [[ -d "$raw" ]]; then
        abs_dir "$raw" || return 1
        return
    fi

    abs_dir "$PWD/$raw" || return 1
}

is_config_mode() {
    local arg

    [[ $# -gt 0 ]] || return 1
    for arg in "$@"; do
        [[ "$arg" == *=* ]] || return 1
    done
    return 0
}

load_config() {
    code_root_raw="${CODE_ROOT:-$PWD}"
    code_root="$code_root_raw"

    if [[ -f "$config_file" ]]; then
        # shellcheck disable=SC1090
        source "$config_file"
    fi

    code_root="${CODE_DIR:-$code_root}"
    code_root="$(abs_dir "$code_root")" || die "CODE_ROOT '$code_root' is not a readable directory."
}

write_config() {
    local scripts_path="$1"
    local code_path="$2"

    {
        printf 'SCRIPTS_DIR=%q\n' "$scripts_path"
        printf 'CODE_DIR=%q\n' "$code_path"
    } > "$config_file"
}

configure_only() {
    local scripts_path="$script_dir"
    local code_path=""
    local key
    local value
    local arg

    for arg in "$@"; do
        key="${arg%%=*}"
        value="${arg#*=}"
        case "$key" in
            scripts)
                scripts_path="$(resolve_dir_arg "$value")" || die "invalid scripts directory '$value'."
                ;;
            code)
                code_path="$(resolve_dir_arg "$value")" || die "invalid code directory '$value'."
                ;;
            *)
                die "unknown configuration key '$key'. Supported keys: scripts, code."
                ;;
        esac
    done

    [[ -d "$scripts_path" ]] || die "scripts directory '$scripts_path' does not exist."
    [[ -d "$code_path" ]] || die "code directory '$code_path' does not exist."

    write_config "$scripts_path" "$code_path"

    echo "Configuration saved in '$config_file'."
    echo "scripts=$scripts_path"
    echo "code=$code_path"
    echo "No scripts were executed."
}

resolve_target_dir() {
    local input_path="$1"

    if [[ "$input_path" == /* && -d "$input_path" ]]; then
        abs_dir "$input_path" || die "failed to resolve '$input_path'."
        return
    fi

    if [[ -d "$code_root/$input_path" ]]; then
        abs_dir "$code_root/$input_path" || die "failed to resolve '$code_root/$input_path'."
        return
    fi

    if [[ -d "$input_path" ]]; then
        abs_dir "$input_path" || die "failed to resolve '$input_path'."
        return
    fi

    die "folder '$input_path' not found."
}

find_norminette_bin() {
    local candidate

    if [[ -n "${NORMINETTE_BIN:-}" && -x "$NORMINETTE_BIN" ]]; then
        printf '%s\n' "$NORMINETTE_BIN"
        return 0
    fi

    candidate="$(command -v norminette 2>/dev/null || true)"
    if [[ -n "$candidate" && -x "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return 0
    fi

    for candidate in \
        "$script_dir/../.venv/bin/norminette" \
        "$code_root/.venv/bin/norminette" \
        "$PWD/.venv/bin/norminette" \
        "$(dirname "$code_root")/.venv/bin/norminette" \
        "$script_dir/../code/.venv/bin/norminette" \
        "$(dirname "$script_dir")/.venv/bin/norminette"; do
        if [[ -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

run_norminette_log() {
    local norm_bin="$1"
    local target="$2"
    local out_log="$3"

    "$norm_bin" "$target" > "$out_log" 2>&1 || true
}

is_whitespace_error_code() {
    local code="$1"

    case "$code" in
        SPACE_REPLACE_TAB|TOO_FEW_TAB|TOO_MANY_TAB|CONSECUTIVE_SPC|SPC_BEFORE_NL|EMPTY_LINE_FUNCTION|SPACE_EMPTY_LINE)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

count_whitespace_errors_in_log() {
    local log_file="$1"

    awk '
/^Error:[[:space:]]*[A-Z_]+/ {
    if (match($0, /^Error:[[:space:]]*([A-Z_]+)/, m)) {
        code = m[1];
        if (code == "SPACE_REPLACE_TAB" || code == "TOO_FEW_TAB" || code == "TOO_MANY_TAB" || code == "CONSECUTIVE_SPC" || code == "SPC_BEFORE_NL" || code == "EMPTY_LINE_FUNCTION" || code == "SPACE_EMPTY_LINE")
            count++;
    }
}
END {
    print count + 0;
}
' "$log_file"
}

collect_whitespace_error_files() {
    local log_file="$1"

    awk '
/: Error!$/ {
    file = $0;
    sub(/: Error!$/, "", file);
    current = file;
    next;
}
/^Error:[[:space:]]*[A-Z_]+/ {
    if (current == "")
        next;
    if (match($0, /^Error:[[:space:]]*([A-Z_]+)/, m)) {
        code = m[1];
        if (code == "SPACE_REPLACE_TAB" || code == "TOO_FEW_TAB" || code == "TOO_MANY_TAB" || code == "CONSECUTIVE_SPC" || code == "SPC_BEFORE_NL" || code == "EMPTY_LINE_FUNCTION" || code == "SPACE_EMPTY_LINE")
            print current;
    }
}
' "$log_file" | sort -u
}

resolve_norm_log_file_path() {
    local target_dir="$1"
    local norm_path="$2"

    if [[ "$norm_path" == /* ]]; then
        printf '%s\n' "$norm_path"
        return
    fi
    if [[ -f "$norm_path" ]]; then
        abs_file "$norm_path" && return
    fi
    if [[ -f "$target_dir/$norm_path" ]]; then
        abs_file "$target_dir/$norm_path" && return
    fi
    printf '%s\n' "$target_dir/$norm_path"
}

run_norminette_whitespace_loop() {
    local target_dir="$1"
    local norm_bin="$2"
    local log_file="$target_dir/.prep-norminette.log"
    local pass
    local ws_count
    local norm_path
    local resolved
    local fixed_any

    for pass in $(seq 1 "$MAX_NORM_PASSES"); do
        run_norminette_log "$norm_bin" "$target_dir" "$log_file"
        ws_count="$(count_whitespace_errors_in_log "$log_file")"

        if [[ "$ws_count" -eq 0 ]]; then
            echo "Norminette whitespace checks passed (pass $pass)."
            echo "Norminette log written to '$log_file'."
            return 0
        fi

        fixed_any=0
        while IFS= read -r norm_path; do
            [[ -n "$norm_path" ]] || continue
            resolved="$(resolve_norm_log_file_path "$target_dir" "$norm_path")"
            if [[ -f "$resolved" ]]; then
                if normalize_file "$resolved"; then
                    fixed_any=1
                fi
            fi
        done < <(collect_whitespace_error_files "$log_file")

        if [[ "$fixed_any" -eq 0 ]]; then
            break
        fi
    done

    run_norminette_log "$norm_bin" "$target_dir" "$log_file"
    ws_count="$(count_whitespace_errors_in_log "$log_file")"
    if [[ "$ws_count" -gt 0 ]]; then
        die "norminette still reports $ws_count whitespace-related error(s). See '$log_file'."
    fi

    echo "Norminette whitespace checks passed."
    echo "Norminette log written to '$log_file'."
}

normalize_file() {
    local file_path="$1"
    local tmp_out
    local tmp_split
    local tmp_final

    if [[ ! -r "$file_path" ]]; then
        warn "skipping unreadable file '$file_path'."
        return 2
    fi
    if [[ ! -w "$file_path" ]]; then
        warn "skipping unwritable file '$file_path'."
        return 2
    fi
    if [[ ! -w "$(dirname "$file_path")" ]]; then
        warn "skipping '$file_path' because its directory is not writable."
        return 2
    fi

    tmp_out="$(mktemp)" || {
        warn "failed to create temporary file for '$file_path'."
        return 2
    }
    tmp_files+=("$tmp_out")

    if ! awk '
BEGIN {
    brace_depth = 0;
    decl_block = 0;
    last_blank = 0;
    sq = sprintf("%c", 39);
}
function collapse_spaces_code(s,    i, c, prev, out, in_sq, in_dq, in_comment, esc) {
    out = "";
    in_sq = 0;
    in_dq = 0;
    in_comment = 0;
    esc = 0;
    for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1);
        prev = (i > 1) ? substr(s, i - 1, 1) : "";

        if (!in_sq && !in_dq && !in_comment && prev == "/" && c == "/") {
            in_comment = 1;
            out = out c;
            esc = 0;
            continue;
        }

        if (!in_comment) {
            if (!in_dq && c == sq && !esc)
                in_sq = !in_sq;
            else if (!in_sq && c == "\"" && !esc)
                in_dq = !in_dq;
        }

        if (!in_sq && !in_dq && !in_comment && c == " " && length(out) > 0 && substr(out, length(out), 1) == " ") {
            esc = 0;
            continue;
        }

        out = out c;

        if (c == "\\" && !esc)
            esc = 1;
        else
            esc = 0;
    }
    return out;
}
{
    line = $0;
    sub(/\r$/, "", line);
    sub(/[ \t]+$/, "", line);

    # Normalize line-end spacing around common delimiters.
    sub(/[ \t]*;[ \t]*$/, ";", line);
    sub(/\{[ \t]*$/, "{", line);
    sub(/\}[ \t]*$/, "}", line);

    indent = "";
    while (substr(line, 1, 4) == "    ") {
        indent = indent "\t";
        line = substr(line, 5);
    }

    if (line ~ /\(/ \
        && line !~ /^[[:space:]]*#/ \
        && line !~ /^[[:space:]]*\/\// \
        && line !~ /^[[:space:]]*\*/ \
        && line !~ /^[[:space:]]*(if|while|for|switch|return|sizeof)\b/) {
        open_pos = index(line, "(");
        if (open_pos > 1) {
            pre = substr(line, 1, open_pos - 1);
            post = substr(line, open_pos);
            if (pre ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]\*]*[ ]+[A-Za-z_][A-Za-z0-9_]*$/) {
                fname = pre;
                sub(/^.*[ ]/, "", fname);
                base = pre;
                sub(/[ ]+[A-Za-z_][A-Za-z0-9_]*$/, "", base);
                pre = base "\t" fname;
                line = pre post;
            }
        }
    }

    if (line !~ /^[[:space:]]*#/ \
        && line !~ /^[[:space:]]*\/\// \
        && line !~ /^[[:space:]]*\*/ \
        && line !~ /=/ \
        && line !~ /\(/ \
        && line ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]\*]*[ ]+[A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?([[:space:]]*=[^;]+)?[[:space:]]*;[[:space:]]*$/) {
        vname = line;
        sub(/^.*[ ]/, "", vname);
        sub(/(\[[^]]*\])?([[:space:]]*=[^;]+)?[[:space:]]*;[[:space:]]*$/, "", vname);
        base = line;
        sub(/[ ]+[A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?([[:space:]]*=[^;]+)?[[:space:]]*;[[:space:]]*$/, "", base);
        rest = line;
        sub(/^.*[ ]+[A-Za-z_][A-Za-z0-9_]*/, "", rest);
        line = base "\t" vname rest;
    }

    if (line !~ /^[[:space:]]*#/ \
        && line !~ /"/ \
        && line !~ /==|!=|<=|>=/ \
        && line ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_\[\]\->\.]*[[:space:]]*=[^=].*;[[:space:]]*$/) {
        eq = index(line, "=");
        if (eq > 0) {
            left = substr(line, 1, eq - 1);
            right = substr(line, eq + 1);
            sub(/[[:space:]]+$/, "", left);
            sub(/^[[:space:]]+/, "", right);
            line = left " = " right;
        }
    }

    line = collapse_spaces_code(line);

    sub(/[ \t]+$/, "", line);

    out = indent line;

    is_blank = (out ~ /^[[:space:]]*$/);
    is_comment = (out ~ /^[[:space:]]*\/\// || out ~ /^[[:space:]]*\/\*/ || out ~ /^[[:space:]]*\*/);
    is_decl = 0;

    if (is_blank) {
        if (last_blank)
            next;
        print "";
        last_blank = 1;
        if (brace_depth <= 0)
            decl_block = 0;
        next;
    }

    if (brace_depth > 0 \
        && out !~ /\(/ \
        && out !~ /^[[:space:]]*#/ \
        && out !~ /^[[:space:]]*(return|if|while|for|switch)\b/ \
        && out ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]\*]*[\t ][A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?([[:space:]]*=[^;]+)?[[:space:]]*;[[:space:]]*$/) {
        is_decl = 1;
    }

    if (brace_depth > 0 && decl_block == 1 && !is_blank && !is_decl && !is_comment) {
        if (!last_blank)
            print "";
        decl_block = 0;
        last_blank = 1;
    }

    print out;
    last_blank = 0;

    if (brace_depth > 0) {
        if (is_decl)
            decl_block = 1;
        else if (!is_blank && !is_comment)
            decl_block = 0;
    } else {
        decl_block = 0;
    }

    tmp = out;
    opens = gsub(/\{/, "{", tmp);
    tmp = out;
    closes = gsub(/\}/, "}", tmp);
    brace_depth += opens - closes;
    if (brace_depth < 0)
        brace_depth = 0;
}
' "$file_path" > "$tmp_out"; then
        warn "failed to normalize '$file_path'."
        return 2
    fi

    tmp_split="$(mktemp)" || {
        warn "failed to create secondary temporary file for '$file_path'."
        return 2
    }
    tmp_files+=("$tmp_split")

    if ! awk '
BEGIN {
    brace_depth = 0;
}
function emit_split_init(line,    sides, lhs, rhs, decl_part, assign_part, name_part, base_part) {
    if (split(line, sides, "=") < 2) {
        print line;
        return;
    }

    lhs = sides[1];
    rhs = sides[2];
    sub(/[[:space:]]+$/, "", lhs);
    sub(/^[[:space:]]+/, "", rhs);
    sub(/[[:space:]]*;[[:space:]]*$/, "", rhs);

    indent_part = lhs;
    sub(/[^[:space:]].*$/, "", indent_part);

    name_part = lhs;
    sub(/^.*[[:space:]]/, "", name_part);

    base_part = lhs;
    sub(/[[:space:]]+[A-Za-z_][A-Za-z0-9_]*$/, "", base_part);

    decl_part = base_part "\t" name_part ";";
    assign_part = indent_part name_part " = " rhs ";";

    print decl_part;
    print "";
    print assign_part;
}
{
    line = $0;
    if (brace_depth > 0 && line ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]*]*[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=[[:space:]]*[^;]+;[[:space:]]*$/ && line !~ /^[[:space:]]*(if|while|for|switch|return)\b/ && line !~ /\(/) {
        emit_split_init(line);
    } else {
        print line;
    }

    tmp = line;
    opens = gsub(/\{/, "{", tmp);
    tmp = line;
    closes = gsub(/\}/, "}", tmp);
    brace_depth += opens - closes;
    if (brace_depth < 0)
        brace_depth = 0;
}
' "$tmp_out" > "$tmp_split"; then
        warn "failed to split initialized declarations in '$file_path'."
        return 2
    fi

    tmp_final="$(mktemp)" || {
        warn "failed to create final temporary file for '$file_path'."
        return 2
    }
    tmp_files+=("$tmp_final")

    if ! awk '
BEGIN {
    brace_depth = 0;
    top_last_blank = 0;
}
function is_decl_line(s,    t) {
    t = s;
    if (t ~ /^[[:space:]]*#/)
        return 0;
    if (t ~ /^[[:space:]]*\/\//)
        return 0;
    if (t ~ /^[[:space:]]*\/\*/)
        return 0;
    if (t ~ /^[[:space:]]*\*/)
        return 0;
    if (t ~ /[(]/)
        return 0;
    if (t ~ /^[[:space:]]*(if|while|for|switch|return)\b/)
        return 0;
    return (t ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]\*]*[\t ][A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?[[:space:]]*;[[:space:]]*$/);
}
{
    line = $0;
    sub(/[ \t]+$/, "", line);

    cur = brace_depth;
    blank = (line ~ /^[[:space:]]*$/);

    if (cur == 0) {
        if (blank) {
            if (!top_last_blank)
                print "";
            top_last_blank = 1;
            next;
        }
        print line;
        top_last_blank = 0;
    } else {
        if (!(cur in block_init)) {
            block_init[cur] = 1;
            decl_mode[cur] = 1;
            saw_decl[cur] = 0;
            pending_blank[cur] = 0;
        }

        if (blank) {
            pending_blank[cur] = 1;
            next;
        }

        decl = is_decl_line(line);

        if (decl_mode[cur] == 1) {
            if (decl) {
                print line;
                saw_decl[cur] = 1;
                pending_blank[cur] = 0;
            } else {
                if (saw_decl[cur] == 1 && line !~ /^[[:space:]]*\}/)
                    print "";
                print line;
                decl_mode[cur] = 0;
                pending_blank[cur] = 0;
            }
        } else {
            print line;
            pending_blank[cur] = 0;
        }
    }

    tmp = line;
    opens = gsub(/\{/, "{", tmp);
    tmp = line;
    closes = gsub(/\}/, "}", tmp);

    if (opens > 0) {
        for (k = 1; k <= opens; k++) {
            d = brace_depth + k;
            block_init[d] = 1;
            decl_mode[d] = 1;
            saw_decl[d] = 0;
            pending_blank[d] = 0;
        }
    }

    brace_depth += opens - closes;
    if (brace_depth < 0)
        brace_depth = 0;
}
' "$tmp_split" > "$tmp_final"; then
        warn "failed to apply function-body spacing rules in '$file_path'."
        return 2
    fi

    if cmp -s "$file_path" "$tmp_final"; then
        return 1
    fi

    if ! chmod --reference="$file_path" "$tmp_final"; then
        warn "failed to preserve permissions for '$file_path'."
        return 2
    fi

    if ! mv "$tmp_final" "$file_path"; then
        warn "failed to replace '$file_path'."
        return 2
    fi

    return 0
}

if is_config_mode "$@"; then
    configure_only "$@"
    exit 0
fi

if [[ $# -ne 1 ]]; then
    usage
    exit 1
fi

input="$1"
[[ -n "$input" ]] || {
    usage
    exit 1
}

load_config

target_dir="$(resolve_target_dir "$input")"
[[ -r "$target_dir" ]] || die "folder '$target_dir' is not readable."

if ! mapfile -t code_files < <(find "$target_dir" -type f \( -name '*.c' -o -name '*.h' \) | sort); then
    die "failed to scan '$target_dir' for .c/.h files."
fi

if [[ ${#code_files[@]} -eq 0 ]]; then
    die "no .c/.h files found under '$target_dir'."
fi

scanned=0
changed=0
failed=0

for file_path in "${code_files[@]}"; do
    scanned=$((scanned + 1))
    if normalize_file "$file_path"; then
        changed=$((changed + 1))
    else
        rc=$?
        if [[ $rc -eq 2 ]]; then
            failed=$((failed + 1))
        fi
    fi
done

if ((failed > 0)); then
    die "whitespace normalization changed $changed file(s), failed for $failed file(s), scanned $scanned file(s)."
fi

echo "Whitespace normalization changed $changed file(s), scanned $scanned file(s)."

if norm_bin="$(find_norminette_bin)"; then
    echo "Using norminette: $norm_bin"
    run_norminette_whitespace_loop "$target_dir" "$norm_bin"
else
    warn "norminette not found (system or .venv). Skipping norminette verification pass."
fi
