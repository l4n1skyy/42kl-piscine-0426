#!/usr/bin/env bash

set -euo pipefail

die() {
    echo "Error: $*" >&2
    exit 1
}

usage() {
    echo "Usage:" >&2
    echo "  $0 scripts=<path> code=<path>" >&2
    echo "  $0 [c-01 c-02 ...]" >&2
    echo "" >&2
    echo "Examples:" >&2
    echo "  $0 scripts=./scripts code=./code" >&2
    echo "  $0 scripts=./scripts code=./" >&2
    echo "  $0" >&2
    echo "  $0 c-01 c-02" >&2
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "required command '$1' not found."
}

for cmd in find grep pwd sort; do
    require_cmd "$cmd"
done

script_dir="$(cd "$(dirname "$0")" && pwd)"
config_file="$script_dir/.prep-code.conf"

abs_dir() {
    local p="$1"

    [[ -d "$p" ]] || return 1
    (cd "$p" && pwd)
}

detect_default_code_dir() {
    local base="$1"

    if [[ -d "$base/code" ]] && find "$base/code" -maxdepth 1 -mindepth 1 -type d -name 'c-[0-9][0-9]' | grep -q .; then
        printf '%s\n' "$base/code"
        return
    fi
    if find "$base" -maxdepth 1 -mindepth 1 -type d -name 'c-[0-9][0-9]' | grep -q .; then
        printf '%s\n' "$base"
        return
    fi
    printf '%s\n' "$base/code"
}

load_config() {
    local base_parent

    base_parent="$(cd "$script_dir/.." && pwd)"
    SCRIPTS_DIR="$script_dir"
    CODE_DIR="$(detect_default_code_dir "$base_parent")"

    if [[ -f "$config_file" ]]; then
        # shellcheck disable=SC1090
        source "$config_file"
    fi
}

write_config() {
    local scripts_path="$1"
    local code_path="$2"

    {
        printf 'SCRIPTS_DIR=%q\n' "$scripts_path"
        printf 'CODE_DIR=%q\n' "$code_path"
    } > "$config_file"
}

resolve_dir_arg() {
    local raw="$1"

    if [[ "$raw" == /* ]]; then
        abs_dir "$raw" || return 1
        return
    fi

    if [[ -d "$raw" ]]; then
        abs_dir "$raw" || return 1
        return
    fi

    abs_dir "$PWD/$raw" || return 1
}

is_config_mode() {
    local arg

    [[ $# -gt 0 ]] || return 1
    for arg in "$@"; do
        [[ "$arg" == *=* ]] || return 1
    done
    return 0
}

configure_only() {
    local scripts_path=""
    local code_path=""
    local key
    local value
    local arg

    for arg in "$@"; do
        key="${arg%%=*}"
        value="${arg#*=}"
        case "$key" in
            scripts)
                scripts_path="$(resolve_dir_arg "$value")" || die "invalid scripts directory '$value'."
                ;;
            code)
                code_path="$(resolve_dir_arg "$value")" || die "invalid code directory '$value'."
                ;;
            *)
                die "unknown configuration key '$key'. Supported keys: scripts, code."
                ;;
        esac
    done

    load_config
    if [[ -z "$scripts_path" ]]; then
        scripts_path="$SCRIPTS_DIR"
    fi
    if [[ -z "$code_path" ]]; then
        code_path="$CODE_DIR"
    fi

    [[ -d "$scripts_path" ]] || die "scripts directory '$scripts_path' does not exist."
    [[ -d "$code_path" ]] || die "code directory '$code_path' does not exist."

    write_config "$scripts_path" "$code_path"

    echo "Configuration saved in '$config_file'."
    echo "scripts=$scripts_path"
    echo "code=$code_path"
    echo "No scripts were executed."
}

resolve_targets() {
    local code_dir="$1"
    shift
    local input

    if [[ $# -eq 0 ]]; then
        if ! mapfile -t TARGETS < <(find "$code_dir" -maxdepth 1 -mindepth 1 -type d -name 'c-[0-9][0-9]' | sort); then
            die "failed to discover c-xx folders under '$code_dir'."
        fi
        [[ ${#TARGETS[@]} -gt 0 ]] || die "no c-xx folders found under '$code_dir'."
        return
    fi

    TARGETS=()
    for input in "$@"; do
        if [[ "$input" == /* && -d "$input" ]]; then
            TARGETS+=("$(abs_dir "$input")")
        elif [[ -d "$code_dir/$input" ]]; then
            TARGETS+=("$(abs_dir "$code_dir/$input")")
        elif [[ -d "$input" ]]; then
            TARGETS+=("$(abs_dir "$input")")
        else
            die "target folder '$input' not found."
        fi
    done
}

run_pipeline() {
    local scripts_dir="$1"
    local code_dir="$2"
    shift 2
    local prep_main
    local prep_header
    local target
    local ok=0
    local fail=0

    prep_main="$scripts_dir/prep-main"
    prep_header="$scripts_dir/prep-header"

    [[ -f "$prep_main" ]] || die "missing '$prep_main'."
    [[ -f "$prep_header" ]] || die "missing '$prep_header'."
    [[ -x "$prep_main" ]] || die "'$prep_main' is not executable."
    [[ -x "$prep_header" ]] || die "'$prep_header' is not executable."

    resolve_targets "$code_dir" "$@"

    for target in "${TARGETS[@]}"; do
        echo "Processing $(basename "$target")..."

        if CODE_ROOT="$code_dir" "$prep_main" "$target"; then
            if CODE_ROOT="$code_dir" "$prep_header" "$target"; then
                ok=$((ok + 1))
            else
                fail=$((fail + 1))
            fi
        else
            fail=$((fail + 1))
        fi
    done

    if ((fail > 0)); then
        die "completed with failures: success=$ok failed=$fail"
    fi

    echo "Completed successfully for $ok folder(s)."
}

if [[ $# -gt 0 ]] && [[ "$1" == "--help" || "$1" == "-h" ]]; then
    usage
    exit 0
fi

if is_config_mode "$@"; then
    configure_only "$@"
    exit 0
fi

load_config
SCRIPTS_DIR="$(abs_dir "$SCRIPTS_DIR")" || die "configured scripts directory '$SCRIPTS_DIR' is invalid."
CODE_DIR="$(abs_dir "$CODE_DIR")" || die "configured code directory '$CODE_DIR' is invalid."

run_pipeline "$SCRIPTS_DIR" "$CODE_DIR" "$@"
